{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caldero-de-cuentos.example/schema/pack-2.json",
  "title": "Pack de contenido de Caldero de Cuentos (esquema 2: premisas)",
  "type": "object",
  "required": [
    "pack",
    "characters",
    "places",
    "morals",
    "premises"
  ],
  "additionalProperties": false,
  "properties": {
    "pack": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "name",
        "version",
        "language"
      ],
      "additionalProperties": true,
      "properties": {
        "schema": {
          "const": 2
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}$"
        },
        "license": {
          "type": "string"
        },
        "age_band": {
          "type": "string"
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "given",
          "noun",
          "gender",
          "roles",
          "alignment",
          "trait"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "noun": {
            "type": "string",
            "minLength": 1
          },
          "gender": {
            "$ref": "#/$defs/gender"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "hero",
                "helper",
                "villain"
              ]
            }
          },
          "alignment": {
            "enum": [
              "positive",
              "negative",
              "ambiguous"
            ]
          },
          "trait": {
            "type": "object",
            "required": [
              "m",
              "f"
            ],
            "additionalProperties": false,
            "properties": {
              "m": {
                "type": "string"
              },
              "f": {
                "type": "string"
              }
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "attrs": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z]\\w*$",
              "not": {
                "enum": [
                  "noun",
                  "el",
                  "un",
                  "del",
                  "al",
                  "en",
                  "o",
                  "trait"
                ]
              }
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "places": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "noun",
          "gender",
          "mood"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "noun": {
            "type": "string",
            "minLength": 1
          },
          "gender": {
            "$ref": "#/$defs/gender"
          },
          "mood": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "morals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "noun",
          "gender"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "noun": {
            "type": "string",
            "minLength": 1
          },
          "gender": {
            "$ref": "#/$defs/gender"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "premises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "value",
          "title",
          "cast",
          "beats"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "value": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "cast": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "character",
                    "place",
                    "prop"
                  ]
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "hero",
                      "helper",
                      "villain"
                    ]
                  }
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                }
              }
            }
          },
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "variants"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "variants": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "id": {
                        "$ref": "#/$defs/id"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "requires": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*(:[a-z][a-z0-9_]*)?$"
                        }
                      },
                      "adds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*(:[a-z][a-z0-9_]*)?$"
                        }
                      },
                      "weight": {
                        "type": "number",
                        "minimum": 0
                      },
                      "scene": {
                        "type": "object",
                        "properties": {
                          "bg": {
                            "$ref": "#/$defs/id"
                          },
                          "actors": {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/id"
                            }
                          },
                          "mood": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "introduces": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/id"
                  }
                },
                "moves": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "gender": {
      "enum": [
        "m",
        "f"
      ]
    }
  }
}
