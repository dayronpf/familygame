  "morals": [
    {
      "id": "honestidad",
      "name": "Honestidad",
      "text": "Un secreto pesa más que la verdad, aunque la verdad dé miedo.",
      "simple": {
        "2-3": "Decir la verdad hace el corazón ligero.",
        "4-5": "Cuando decimos la verdad, el corazón se siente ligero."
      }
    },
    {
      "id": "generosidad",
      "name": "Generosidad",
      "text": "Cuando compartimos lo poco que tenemos, la alegría crece para todos.",
      "simple": {
        "2-3": "Compartir es bonito.",
        "4-5": "Si compartimos, hay alegría para todos."
      }
    },
    {
      "id": "valentia",
      "name": "Valentía",
      "text": "Ser valiente no es no tener miedo, sino dar el primer paso a pesar de él.",
      "simple": {
        "2-3": "Con un pasito pequeño se empieza.",
        "4-5": "Un paso pequeñito, y luego otro, y llegamos lejos."
      }
    },
    {
      "id": "humildad",
      "name": "Humildad",
      "text": "Presumir no hace más grande a nadie; pedir ayuda y reconocer un error, sí.",
      "simple": {
        "2-3": "Pedir ayuda está bien.",
        "4-5": "Pedir ayuda también es de grandes."
      }
    },
    {
      "id": "perseverancia",
      "name": "Perseverancia",
      "text": "Lo que parece imposible se consigue con un intento más, y otro, y otro.",
      "simple": {
        "2-3": "Otra vez, otra vez, y lo logramos.",
        "4-5": "Si lo intentamos otra vez, y pensamos un poquito, lo conseguimos."
      }
    },
    {
      "id": "amistad",
      "name": "Amistad",
      "text": "Un amigo de verdad está a tu lado cuando lo necesitas y se alegra de cómo eres.",
      "simple": {
        "2-3": "Los amigos se cuidan.",
        "4-5": "Los buenos amigos nos ayudan cuando estamos tristes."
      }
    }
  ],
