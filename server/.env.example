# ─────────────────────────────────────────────────────────────────────────────
# Mininoches · servidor (API para la app + panel del SuperAdmin)
# Copie este archivo a .env y complete los valores. El .env NUNCA se sube al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=Mininoches
# local | production
APP_ENV=local
# Se genera con: php artisan key:generate. También cifra los tokens de compra guardados: si la cambia, no se podrán
# volver a consultar las compras ya guardadas (la app las vuelve a presentar al abrir).
APP_KEY=
# false en producción
APP_DEBUG=true
# URL pública del servidor (en el teléfono, la de su computadora en la Wi-Fi, p. ej. http://192.168.1.20:8000)
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Registro de errores. No se registran peticiones, IP ni datos de la app.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Base de datos ───────────────────────────────────────────────────────────
# Por defecto SQLite en database/database.sqlite (se crea solo). Para MySQL o Postgres:
#   DB_CONNECTION=mysql (o pgsql), DB_HOST, DB_PORT (3306 / 5432), DB_DATABASE, DB_USERNAME, DB_PASSWORD
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=mininoches
# DB_USERNAME=mininoches
# DB_PASSWORD=

# ── Sesión del panel ────────────────────────────────────────────────────────
# «file» a propósito: el driver «database» de Laravel guarda la IP y el navegador de cada sesión.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true en producción (solo HTTPS)
SESSION_SECURE_COOKIE=false

# Caché (token de acceso de Google y límites de ritmo). database funciona con varios procesos; file también sirve.
CACHE_STORE=database
# Almacén aparte para los límites de ritmo (vacío = el mismo). Con Redis: CACHE_LIMITER_STORE=redis
CACHE_LIMITER_STORE=
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Detrás de un proxy o balanceador (Nginx, Cloudflare, Fly, Render…): «*» o las IP del proxy separadas por comas,
# para que el límite de ritmo vea la IP del teléfono. Vacío si PHP recibe las conexiones directamente.
TRUSTED_PROXIES=

# ── Mininoches ──────────────────────────────────────────────────────────────
# Carpeta de los packs ({id}/pack.json). Por defecto ../content/packs (la del repositorio).
MININOCHES_PACKS_PATH=
# Cuentos gratis la primera vez que se importan (luego se cambian en el panel)
MININOCHES_DEFAULT_FREE=medieval:sombras,mar:galletas_todos,cosmos:chispa_perdida

# Clave SECRETA Ed25519 (base64) con la que se firman los derechos. Genérela con: php artisan mininoches:keys
# (el comando imprime también la clave PÚBLICA que va en la app). Sin ella, compras y códigos responden 503.
ENTITLEMENT_SIGNING_KEY=

# ── Google Play ─────────────────────────────────────────────────────────────
# Nombre del paquete de la app en Play Console
GOOGLE_PLAY_PACKAGE=com.calderodecuentos.cuentos
# Ruta al JSON de la cuenta de servicio (fuera de public/, p. ej. storage/app/private/google-play.json),
# o el contenido del JSON en una sola línea si el hosting solo admite variables. Vacío = verificación desactivada (503).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Secreto largo y aleatorio que va en la URL de push de Pub/Sub: https://su-servidor/v1/webhooks/google?token=ESTE_VALOR
# Genérelo con: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
GOOGLE_RTDN_TOKEN=
# Confirmar (acknowledge) desde el servidor las suscripciones que lleguen sin confirmar
GOOGLE_ACKNOWLEDGE=true

# ── Límites de ritmo (peticiones por minuto y por IP) ──────────────────────
RATE_LIMIT_API=60
RATE_LIMIT_VERIFY=20
RATE_LIMIT_REDEEM=5
RATE_LIMIT_FEEDBACK=30
RATE_LIMIT_WEBHOOKS=300
# Intentos de entrada al panel por minuto (por correo + IP)
RATE_LIMIT_ADMIN_LOGIN=5
