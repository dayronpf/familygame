# ─────────────────────────────────────────────────────────────────────────────
#  Mininoches · TODAS las credenciales del proyecto, en un solo lugar.
#
#  Copia este archivo como credenciales/.env y llénalo. credenciales/.env NUNCA se sube a git
#  (está en .gitignore). Este .env.ejemplo sí se sube: solo tiene los nombres, sin valores.
#  Las herramientas (tools/voice/render_catalog.py, tools/content/publish.py) leen credenciales/.env.
# ─────────────────────────────────────────────────────────────────────────────

# ── ElevenLabs (grabar la voz de los cuentos) ────────────────────────────────
ELEVENLABS_API_KEY=
# Narradora: Isabela (biblioteca, uso comercial). Modelo: eleven_multilingual_v2.
ELEVENLABS_VOICE_ID=1BxAZWANeDIxeyHKSJF2

# ── Cloudflare R2 (audio y cuentos nuevos; tools/content/publish.py --subir) ─
# Endpoint: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_BUCKET=mininoches
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Dirección pública del bucket (dominio propio), con / al final. Va también en app/lib/src/brand.dart.
CONTENIDO_URL_PUBLICA=

# ── Despliegue del servidor (GitHub Actions → secretos del repositorio) ──────
# Estos cuatro se copian a GitHub: Settings → Secrets and variables → Actions.
FTP_SERVER=
FTP_USERNAME=
FTP_PASSWORD=
# Clave larga al azar. La misma va en el .env del servidor como MININOCHES_DEPLOY_TOKEN.
DEPLOY_TOKEN=

# ── cPanel / base de datos (también van en el .env del servidor) ─────────────
DB_DATABASE=tuven780_cuentos
DB_USERNAME=tuven780_cuentos
DB_PASSWORD=

# ── Servidor Laravel: lo que va en external/cuentos.tuvendor.com/.env ────────
# (APP_KEY y ENTITLEMENT_SIGNING_KEY se generan en el servidor con artisan; anótalos aquí de respaldo)
APP_KEY=
ENTITLEMENT_SIGNING_KEY=
# Panel del SuperAdmin (https://cuentos.tuvendor.com/admin)
ADMIN_EMAIL=

# ── Google Play ──────────────────────────────────────────────────────────────
GOOGLE_PLAY_PACKAGE=
# Ruta al JSON de la cuenta de servicio (guárdalo dentro de credenciales/)
GOOGLE_SERVICE_ACCOUNT_JSON=credenciales/google-play-servicio.json
GOOGLE_RTDN_TOKEN=

# ── App Store (App Store Connect → Usuarios y acceso → Integraciones) ────────
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# Ruta a la clave .p8 (guárdala dentro de credenciales/)
APPLE_PRIVATE_KEY=credenciales/AuthKey.p8
APPLE_BUNDLE_ID=

# ── Firma de la app Android (subir a Google Play) ────────────────────────────
ANDROID_KEYSTORE=credenciales/mininoches-upload.jks
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=

# Código para los revisores de las tiendas (también como secreto de GitHub REVIEW_CODE)
REVIEW_CODE=
